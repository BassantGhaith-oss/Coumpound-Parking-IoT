        "name": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div style=\"font-family: Arial; padding: 20px;\">\n\n    <h1>🚗 SMART GARAGE</h1>\n\n    <h2>\n        Status: {{msg.payload.garageStatus}}\n    </h2>\n\n    <h3>\n        Available: {{msg.payload.available}}\n        | Occupied: {{msg.payload.occupied}}\n    </h3>\n\n    <hr>\n\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px;\">\n\n        <div style=\"padding: 20px; border-radius: 10px; background: #eeeeee;\">\n            <h2>Spot 1</h2>\n            <p>Status: {{msg.payload.spots[1].status}}</p>\n            <p>Duration: {{msg.payload.spots[1].duration}} s</p>\n            <p>Fee: {{msg.payload.spots[1].fee}} LE</p>\n        </div>\n\n        <div style=\"padding: 20px; border-radius: 10px; background: #eeeeee;\">\n            <h2>Spot 2</h2>\n            <p>Status: {{msg.payload.spots[2].status}}</p>\n            <p>Duration: {{msg.payload.spots[2].duration}} s</p>\n            <p>Fee: {{msg.payload.spots[2].fee}} LE</p>\n        </div>\n\n        <div style=\"padding: 20px; border-radius: 10px; background: #eeeeee;\">\n            <h2>Spot 3</h2>\n            <p>Status: {{msg.payload.spots[3].status}}</p>\n            <p>Duration: {{msg.payload.spots[3].duration}} s</p>\n            <p>Fee: {{msg.payload.spots[3].fee}} LE</p>\n        </div>\n\n        <div style=\"padding: 20px; border-radius: 10px; background: #eeeeee;\">\n            <h2>Spot 4</h2>\n            <p>Status: {{msg.payload.spots[4].status}}</p>\n            <p>Duration: {{msg.payload.spots[4].duration}} s</p>\n            <p>Fee: {{msg.payload.spots[4].fee}} LE</p>\n        </div>\n\n    </div>\n\n</div>",
