    {
        "id": "8c34dc5988b17314",
        "type": "function",
        "z": "f06d6b62baf03edf",
        "name": "main function",
        "func": "let spots = context.get(\"spots\") || {\n    1: { status: \"available\", duration: 0, fee: 0 },\n    2: { status: \"available\", duration: 0, fee: 0 },\n    3: { status: \"available\", duration: 0, fee: 0 },\n    4: { status: \"available\", duration: 0, fee: 0 }\n};\n\nlet data = msg.payload;\nlet spot = data.spot;\n\nif (data.status === \"occupied\") {\n    spots[spot].status = \"occupied\";\n}\n\nif (data.status === \"available\") {\n    spots[spot].status = \"available\";\n    spots[spot].duration = data.duration || 0;\n    spots[spot].fee = data.fee || 0;\n}\n\ncontext.set(\"spots\", spots);\n\nlet occupied = 0;\n\nfor (let i = 1; i <= 4; i++) {\n    if (spots[i].status === \"occupied\") {\n        occupied++;\n    }\n}\n\nlet available = 4 - occupied;\n\nlet garageStatus;\n\nif (available === 0) {\n    garageStatus = \"Full\";\n} else if (available > 2) {\n    garageStatus = \"Available\";\n} else {\n    garageStatus = \"Limited\";\n}\n\nmsg.payload = {\n    spots: spots,\n    occupied: occupied,\n    available: available,\n    garageStatus: garageStatus\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 300,
        "wires": [
            [
                "bc50b70610ff8f3b",
                "80511bbaecfe2c08",
                "6f5503f88739914a"
            ]
        ]
    },
